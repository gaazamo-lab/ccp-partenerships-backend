# ── Core ──
ENV=dev                                # dev | staging | production
DEBUG=true                             # exposes /api/v1/docs; never true in production
SQL_ECHO=false                         # log every SQL statement
SECRET_KEY=change-me-in-production     # >= 32 random chars in production
API_PREFIX=/api/v1

# ── Database / queue ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/partner_crm
REDIS_URL=redis://localhost:6379/0

# ── Sessions (email + password, HTTP-only cookie) ──
SESSION_COOKIE_SECURE=false            # true behind HTTPS (required in production)
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# ── CSRF: comma-separated origins allowed to send state-changing requests ──
ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179

# ── Bootstrap administrator (scripts/seed.py) ──
BOOTSTRAP_ADMIN_EMAIL=admin@clet.gov.gh
BOOTSTRAP_ADMIN_PASSWORD=

# ── Integrations: empty URL = not connected, messages wait in the outbox ──
S074_COMMS_URL=
S074_API_KEY=
S203_SCREENING_URL=
S203_API_KEY=
S204_AUDIT_URL=
S011_GIFTS_URL=
S225_ANALYTICS_URL=
INTEGRATION_TIMEOUT_SECONDS=10
OUTBOX_MAX_ATTEMPTS=8
RENEWAL_ALERT_DEFAULT_RECIPIENTS=partnerships@clet.gov.gh,registrar@clet.gov.gh

# ── Public endpoint limits (per client IP per minute) ──
PUBLIC_SUBMISSIONS_PER_MINUTE=20
MICROSITE_UNLOCK_ATTEMPTS_PER_MINUTE=10
